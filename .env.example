# Copy this file to `.env` (same folder as app.py) and fill it in to send REAL emails. Never share or commit `.env`.
# Free option: a Gmail account with 2-Step Verification on, plus an "App password" (Google Account > Security > App passwords). Limit: about 500 emails a day.
# Free alternative: Brevo (smtp-relay.brevo.com, port 587, 300 emails a day); use its SMTP login and key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=FaceVeda <your.address@gmail.com>
APP_URL=http://127.0.0.1:7890
# How often the reminder check runs, in seconds (default 600)
REMINDER_INTERVAL_SECONDS=600
