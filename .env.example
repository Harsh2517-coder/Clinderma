# Copy this file to `.env` (same folder as app.py) and fill it in to send REAL emails. Never share or commit `.env`.
# Free option: a Gmail account with 2-Step Verification on, plus an "App password" (Google Account > Security > App passwords). Limit: about 500 emails a day.
# Free alternative: Brevo (smtp-relay.brevo.com, port 587, 300 emails a day); use its SMTP login and key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=FaceVeda <your.address@gmail.com>
APP_URL=http://127.0.0.1:7890
# How often the reminder check runs, in seconds (default 600)
REMINDER_INTERVAL_SECONDS=600

# --- Acne detector (the friend's Roboflow RF-DETR small model). Leave commented until the model file is in models/ ---
# DETECTOR=rfdetr                          # use `onnx` if you get an .onnx file (recommended) or `rfdetr` for a .pth checkpoint (needs `pip install rfdetr`)
# DETECTOR_PATH=models/acne_rfdetr_small.pth
# DETECTOR_VARIANT=small
# DETECTOR_CLASSES=comedone,papule,pustule,nodule,cyst   # in the model's index order (0..4): confirm with the friend
# DETECTOR_INPUT=full                      # trained on plain photos, so give it the whole photo (not the CLAHE cutout)
# DETECTOR_CONF=0.15                       # the friend's backend default
# DETECTOR_SIZE=512                        # only for .onnx with a dynamic input; RF-DETR small is normally 512
